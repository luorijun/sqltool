{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/main/**/*.ts", "src/contracts/**/*.ts"]
}
