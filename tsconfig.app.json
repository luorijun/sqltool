{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "esnext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true
  },
  "include": ["src/renderer/**/*", "src/contracts/**/*.ts"]
}
